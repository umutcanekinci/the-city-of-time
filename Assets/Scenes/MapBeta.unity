    - target: {fileID: 2029602330456896938, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6271906065691911538, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: m_Name
      value: "\xC7ift\xE7i Derya Nine"
      objectReference: {fileID: 0}
    - target: {fileID: 8283833201645967716, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: dialogue
      value: 
      objectReference: {fileID: 381196370}
    - target: {fileID: 8283833201645967716, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: busyConversation
      value: "\u201CTencerede s\xFCt kaynat\u0131yorum, ba\u015F\u0131ndan ayr\u0131lamam.
        S\xFCt\xFC getirirsen yo\u011Furt da mayalar\u0131z, ne dersin?\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8283833201645967716, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: conversationLines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8283833201645967716, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: 'conversationLines.Array.data[0]'
      value: "\u201CAh evlad\u0131m, ya\u015Fl\u0131l\u0131k i\u015Fte... Elleri
        eskisi gibi tutmuyor.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8283833201645967716, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: 'conversationLines.Array.data[1]'
      value: "\u201CAh\u0131rdaki inekler sab\u0131rs\u0131z, sa\u011F\u0131lmazlarsa
        huysuzla\u015F\u0131yorlar. Gidip onlar\u0131 sa\u011Far ve s\xFCtleri getirir
        misin bana? Kar\u015F\u0131l\u0131\u011F\u0131nda g\xFCzel bir ikram\u0131m
        olacak.\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8283833201645967716, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: 'conversationLines.Array.data[2]'
      value: "\u201CAh evlad\u0131m, ya\u015Fl\u0131l\u0131k i\u015Fte... Elleri
        eskisi gibi tutmuyor.\u201D"
      objectReference: {fileID: 0}
