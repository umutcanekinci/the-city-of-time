    - target: {fileID: 6271906065691911538, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: m_Name
      value: Zehra Komiser
      objectReference: {fileID: 0}
    - target: {fileID: 8283833201645967716, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: dialogue
      value: 
      objectReference: {fileID: 381196370}
    - target: {fileID: 8283833201645967716, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: busyConversation
      value: "\u201CBu raporu tamamlamam gerek, g\xF6z\xFCm sand\u0131klarda ama
        elim ka\u011F\u0131tlarda. Anahtarlar\u0131 bulursan do\u011Frudan bana getir,
        olur mu?\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8283833201645967716, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: conversationLines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8283833201645967716, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: 'conversationLines.Array.data[0]'
      value: "\u201CBak \u015Fu sand\u0131klara.\u201D (Sand\u0131klar\u0131 eliyle
        g\xF6sterir)"
      objectReference: {fileID: 0}
    - target: {fileID: 8283833201645967716, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: 'conversationLines.Array.data[1]'
      value: "\u201CBak \u015Fu sand\u0131klara.\u201D (Sand\u0131klar\u0131 eliyle
        g\xF6sterir)"
      objectReference: {fileID: 0}
    - target: {fileID: 8283833201645967716, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: 'conversationLines.Array.data[2]'
      value: "\u201CHepsi m\xFCh\xFCrl\xFC ama anahtarlar\u0131 ortada yok! Biri
        ortal\u0131\u011F\u0131 kar\u0131\u015Ft\u0131rmakla me\u015Fgul, eminim.
        \u015Eehrin civar\u0131n\u0131 ara\u015Ft\u0131r, anahtarlar\u0131 bul ve
        geri getir. Bu sand\u0131klar\u0131n i\xE7indekiler \u015Fehir i\xE7in \xF6nemli
        olabilir.\u201D"
      objectReference: {fileID: 0}
