    - target: {fileID: 6271906065691911538, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: m_Name
      value: Oduncu Mahmut
      objectReference: {fileID: 0}
    - target: {fileID: 8283833201645967716, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: dialogue
      value: 
      objectReference: {fileID: 381196370}
    - target: {fileID: 8283833201645967716, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: busyConversation
      value: "\u201C\u015Eimdi konu\u015Facak zaman de\u011Fil, \u015Fu k\xFCt\xFC\u011F\xFC
        ikiye b\xF6lmem gerekiyor. Sonra g\xF6r\xFC\u015F\xFCr\xFCz, tamam m\u0131?\u201D"
      objectReference: {fileID: 0}
    - target: {fileID: 8283833201645967716, guid: 57586e1c9b9f2bc409d07448961c0856, type: 3}
      propertyPath: 'conversationLines.Array.data[0]'
      value: "\u201COrman\u0131n giri\u015Finde d\xFC\u015Fen birka\xE7 a\u011Fa\xE7
        var, ama tek ba\u015F\u0131ma hepsini ta\u015F\u0131yamam. Sa\u011Flam bir
        balta al ve birka\xE7 par\xE7a odun getir bana. Sobam\u0131 yakacak kuru
        odunum kalmad\u0131. Yard\u0131m edersen sana da bir par\xE7a kestane veririm
        belki!\u201D"
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
